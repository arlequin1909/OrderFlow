# Copiar a .env si necesitas apuntar a una URL distinta a la de desarrollo local por defecto.
# InventoryWorker no tiene URL propia: es un servicio de background puro sin superficie HTTP;
# el catálogo de productos (GET /api/catalog) lo expone OrdersApi.
VITE_ORDERS_API_URL=http://localhost:5081

# Frecuencia (ms) del polling de la lista de pedidos.
VITE_POLL_INTERVAL_MS=4000
