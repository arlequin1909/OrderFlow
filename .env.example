# Copiar a .env y ajustar si hace falta. docker-compose.yml lee estas variables
# automáticamente; los proyectos .NET usan las de más abajo (ConnectionStrings__* y
# RabbitMq__*) siguiendo la convención de configuración de ASP.NET Core (env vars con "__"
# como separador de sección).

# --- PostgreSQL (contenedor) ---
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
POSTGRES_PORT=5432

# --- RabbitMQ (contenedor) ---
RABBITMQ_DEFAULT_USER=orderflow
RABBITMQ_DEFAULT_PASS=orderflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Puertos publicados en el host por docker-compose (opcionales, tienen default) ---
# InventoryWorker no aparece aquí: es un servicio de background puro sin superficie HTTP, así
# que no publica ningún puerto.
ORDERS_API_PORT=5081
FRONTEND_PORT=5173

# --- Variables leídas por OrdersApi cuando corre fuera de Docker (dotnet run) ---
# Si las apps corren en su propio contenedor en la misma red de docker-compose, usar
# "postgres" y "rabbitmq" como host en lugar de "localhost" (docker-compose.yml ya lo hace
# automáticamente por su cuenta para los contenedores de la app).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=orderflow;Username=orderflow;Password=orderflow
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=orderflow
RabbitMq__Password=orderflow
RabbitMq__VirtualHost=/

# --- Ambiente ---
# OrdersApi (WebApplication) usa ASPNETCORE_ENVIRONMENT; InventoryWorker (generic host puro,
# sin ASP.NET Core) usa DOTNET_ENVIRONMENT en su lugar — ver README "Architecture decisions".
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
